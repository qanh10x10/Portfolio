[Unit]
Description=Hollow React Portfolio
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/data/Portfolio
ExecStart=/home/opc/.local/bin/node /data/Portfolio/server.mjs
Environment=NODE_ENV=production
Environment=PORT=29800
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
